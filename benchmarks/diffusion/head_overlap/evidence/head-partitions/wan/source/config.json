{
  "engine": {
    "dtype": "bfloat16",
    "quantization_config": {
      "transformer": {
        "method": "fp8"
      }
    },
    "diffusion_attention_config": {
      "default": "FLASH_ATTN"
    },
    "enable_diffusion_pipeline_profiler": false,
    "enforce_eager": true,
